# Generates the tool table of the `hicexplorer` command (cpp/tools/hicexplorer.cpp).
#
#   cmake -DLIST=<entries file> -DOUTPUT=<include file> -P HicxToolList.cmake
#
# Each line of LIST is `<name>|exe|<path>` for a C++ executable or
# `<name>|python|<path>` for a Python driver (pyproject.toml console script).
# The description of an executable is the "description" of its own
# --help-json; that of a driver is the description="""...""" of its argparse
# parser. OUTPUT receives `kTools[]`, one {name, description} per line of LIST,
# with the descriptions as raw string literals.

cmake_minimum_required(VERSION 3.24)

file(STRINGS "${LIST}" _entries)
set(_body "")
foreach(_entry IN LISTS _entries)
    string(REPLACE "|" ";" _fields "${_entry}")
    list(GET _fields 0 _name)
    list(GET _fields 1 _kind)
    list(GET _fields 2 _path)
    if(_kind STREQUAL "exe")
        execute_process(COMMAND "${_path}" --help-json
                        OUTPUT_VARIABLE _json ERROR_VARIABLE _error RESULT_VARIABLE _status)
        if(NOT _status EQUAL 0)
            message(FATAL_ERROR "${_name} --help-json exited ${_status}: ${_error}")
        endif()
        string(JSON _description ERROR_VARIABLE _json_error GET "${_json}" description)
        if(_json_error)
            message(FATAL_ERROR "${_name} --help-json: ${_json_error}")
        endif()
    elseif(_kind STREQUAL "python")
        file(READ "${_path}" _source)
        string(REGEX MATCH "description=\"\"\"([^\"]*)\"\"\"" _match "${_source}")
        if(NOT _match)
            message(FATAL_ERROR "${_path}: no description=\"\"\"...\"\"\" in its parser")
        endif()
        set(_description "${CMAKE_MATCH_1}")
    else()
        message(FATAL_ERROR "unknown entry kind ${_kind} in ${LIST}")
    endif()
    string(FIND "${_description}" ")hicx\"" _clash)
    if(NOT _clash EQUAL -1)
        message(FATAL_ERROR "the description of ${_name} contains the raw string delimiter")
    endif()
    string(APPEND _body "    {\"${_name}\", R\"hicx(${_description})hicx\"},\n")
endforeach()

set(_content "// Generated by cpp/cmake/HicxToolList.cmake from the tools' own specifications.\n")
string(APPEND _content "const ToolEntry kTools[] = {\n${_body}};\n")
file(WRITE "${OUTPUT}" "${_content}")
