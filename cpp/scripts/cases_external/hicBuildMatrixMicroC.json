[
  {
    "id": "ext.hicBuildMatrixMicroC.SRR927086_2M.bs100kb",
    "tool": "hicBuildMatrixMicroC",
    "tier": 4,
    "args": [
      "-s",
      "{data}/derived/matrix/SRR927086_1_first2000000.bam",
      "{data}/derived/matrix/SRR927086_2_first2000000.bam",
      "-bs",
      "100000",
      "--outFileName",
      "{out}/matrix.h5",
      "-b",
      "{out}/valid.bam",
      "--QCfolder",
      "{out}/qc",
      "--threads",
      "4"
    ],
    "outputs": [
      {
        "path": "{out}/matrix.h5",
        "format": "h5",
        "class": "E2"
      }
    ],
    "notes": "The same 2,000,000 SRR927086 read pairs as the hicBuildMatrix cases (derive_matrix.sh step 2), Micro-C mode with bin size only (no restriction sites). The data is HindIII Hi-C; the case checks the Micro-C code path on real alignments, not Micro-C biology. valid.bam is written but not declared (see the hicBuildMatrix bs100kb case).",
    "threads_arg": "--threads",
    "large": true,
    "memory": {
      "budget_mb": 348
    }
  },
  {
    "id": "ext.hicBuildMatrixMicroC.SRR927086_2M.qc_log.bs1Mb",
    "tool": "hicBuildMatrixMicroC",
    "tier": 4,
    "args": [
      "-s",
      "{data}/derived/matrix/SRR927086_1_first2000000.bam",
      "{data}/derived/matrix/SRR927086_2_first2000000.bam",
      "-bs",
      "1000000",
      "--outFileName",
      "ext_bmmc_qc_matrix.cool",
      "--QCfolder",
      "{out}/qc",
      "--threads",
      "4"
    ],
    "outputs": [
      {
        "path": "{out}/qc/QC.log",
        "format": "plain",
        "class": "E0"
      },
      {
        "path": "{out}/qc/QC_table.txt",
        "format": "plain",
        "class": "E0"
      },
      {
        "path": "{out}/qc/discarded_table.txt",
        "format": "plain",
        "class": "E0"
      },
      {
        "path": "{out}/qc/distance_table.txt",
        "format": "plain",
        "class": "E0"
      },
      {
        "path": "{out}/qc/read_orientation_table.txt",
        "format": "plain",
        "class": "E0"
      },
      {
        "path": "{out}/qc/unmapable_table.txt",
        "format": "plain",
        "class": "E0"
      }
    ],
    "notes": "As above at 1 Mb with the output name relative to the work directory, so QC.log compares byte for byte.",
    "threads_arg": "--threads",
    "large": true,
    "memory": {
      "budget_mb": 348
    }
  }
]
