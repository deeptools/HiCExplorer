[
  {
    "id": "ext.hicFindRestSite.hg19_chr19_21_22.HindIII",
    "tool": "hicFindRestSite",
    "tier": 2,
    "args": [
      "-f",
      "{data}/derived/matrix/hg19_chr19_chr21_chr22.fa",
      "-p",
      "AAGCTT",
      "-o",
      "{out}/sites.bed"
    ],
    "outputs": [
      {
        "path": "{out}/sites.bed",
        "format": "plain",
        "class": "E0"
      }
    ],
    "notes": "UCSC hg19 chr19, chr21 and chr22 (soft-masked, samtools faidx, derive_matrix.sh step 3), HindIII AAGCTT."
  },
  {
    "id": "ext.hicFindRestSite.hg19_genome.HindIII_DpnII",
    "tool": "hicFindRestSite",
    "tier": 2,
    "args": [
      "-f",
      "{data}/genome/hg19.fa",
      "-p",
      "AAGCTT",
      "GATC",
      "-o",
      "{out}/sites.bed"
    ],
    "outputs": [
      {
        "path": "{out}/sites.bed",
        "format": "plain",
        "class": "E0"
      }
    ],
    "notes": "The whole UCSC hg19 FASTA (93 sequences, 3.1 Gb) with HindIII and DpnII; about 8 M sites.",
    "large": true
  }
]
