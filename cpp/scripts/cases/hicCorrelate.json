  {
    "id": "hicCorrelate.pearson_three_matrices",
    "tool": "hicCorrelate",
    "tier": 7,
    "args": [
      "--matrices",
      "{data}/Li_et_al_2015.h5",
      "{data}/Li_et_al_2015_twice.h5",
      "{data}/Li_et_al_2015.cool",
      "--method",
      "pearson",
      "--outFileNameHeatmap",
      "{out}/heatmap.png",
      "--outFileNameScatter",
      "{out}/scatter.png",
      "--zMin",
      "-0.5",
      "--colorMap",
      "viridis"
    ],
    "outputs": [
      {
        "path": "{out}/heatmap.png",
        "format": "png",
        "class": "E6"
      },
      {
        "path": "{out}/scatter.png",
        "format": "png",
        "class": "E6"
      }
    ],
    "notes": "Three float64 matrices of the same bins, Pearson without log1p, default labels: the 3 by 3 correlation matrix is clustered by complete linkage. Budget: hicCorrelate holds, for every stored position of the union, its key and one float64 per matrix (8 + 8n bytes against the 12 bytes per stored value W counts), plus the matrix being read, so the working set grows with the number of matrices: about (2/3)(n + 1) W + 1.3 W, 4.0 W for n = 3 (measured 141.5 MB against 620 MB for the Python tool). The tool default alpha of 1.3 describes one matrix.",
    "memory": {
      "alpha": 4.5,
      "beta": 0.0
    }
  },
